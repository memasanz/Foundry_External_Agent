# Found on the Foundry project Overview page.
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>

# Found on the connected Application Insights resource Overview page.
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/

# The Foundry registration name. Use letters, numbers, hyphens, or underscores.
AGENT_NAME=my-external-agent

# Must exactly match gen_ai.agent.id on every emitted agent span.
OTEL_AGENT_ID=my-external-agent-v1

# Chat-capable model deployment used by the runnable external agent.
MODEL_DEPLOYMENT_NAME=gpt-4.1

# Keep false unless your data policy permits prompts and responses in logs.
LOG_MESSAGE_CONTENT=false
